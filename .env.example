# Copy this file to .env and fill in real values. .env is gitignored.

# ── Database — PostgreSQL ────────────────────────────────────────────────
# Use your provider's *pooled* connection string if it offers one (e.g.
# Neon's "Pooled connection") — this app opens a fresh connection per
# request, and pooling keeps that from exhausting a managed DB's
# connection cap.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Email (SMTP) — Gmail ─────────────────────────────────────────────────
# Gmail needs an App Password (not your login password):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=you@gmail.com
SMTP_TLS=1

# ── SMS — Twilio ────────────────────────────────────────────────────────
# All three from https://console.twilio.com/
#   TWILIO_ACCOUNT_SID   dashboard "Account Info", starts with AC (34 chars)
#   TWILIO_AUTH_TOKEN    same panel, click to reveal (32 hex chars)
#   TWILIO_FROM_NUMBER   an SMS-capable Twilio number you own, E.164 (+15551234567)
# Trial accounts can only text numbers you've verified under
# Phone Numbers > Verified Caller IDs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Optional ────────────────────────────────────────────────────────────
# SECRET_KEY=long-random-string
# SLACK_WEBHOOK_URL=
